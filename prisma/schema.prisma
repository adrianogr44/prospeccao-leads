// Banco local SQLite. SQLite não tem enum nem JSON nativos no Prisma:
// campos de "enum" são String (valores válidos em src/lib/contract.ts)
// e campos JSON são String serializada.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id         String @id @default(cuid())
  source     String // "google" | "osm"
  externalId String // place id do Google ou "node/123" do OSM
  // Chave para evitar duplicado entre fontes diferentes (nome normalizado + telefone ou coordenada)
  dedupeKey  String

  name           String
  category       String?
  city           String?
  state          String?
  neighborhood   String?
  address        String?
  postalCode     String?
  lat            Float?
  lng            Float?
  mapsUrl        String?
  businessStatus String? // "OPERATIONAL" | "CLOSED_TEMPORARILY" | "CLOSED_PERMANENTLY"

  website      String?
  siteStatus   String  @default("UNKNOWN") // SiteStatus em contract.ts
  sitePlatform String?
  siteSignals  String? // JSON: string[] com os sinais da heurística de site antigo

  rating       Float?
  reviewCount  Int?
  openingHours String?

  whatsapp      String? // só quando publicado explicitamente (wa.me, contact:whatsapp)
  phone         String?
  phoneIsMobile Boolean @default(false)
  email         String?
  facebook      String?
  instagram     String?
  linkedin      String?
  tiktok        String?
  ownerName     String?
  notes         String?
  contactedAt   DateTime? // quando a proposta foi enviada; nunca é apagado por nova pesquisa

  // Procedência do contato preenchido por enriquecimento externo (ContactSource em contract.ts).
  // Dado cadastral: pode estar desatualizado, então a interface identifica a origem e a data do dump.
  contactSource   String? // "receita" | null
  contactSourceAt DateTime? // data do dump que forneceu o contato

  score        Int    @default(0) // 0-100
  stars        Int    @default(1) // 1-5
  scoreReasons String @default("[]") // JSON: string[]

  fetchedAt  DateTime  @default(now()) // última vez que a fonte foi consultada
  enrichedAt DateTime? // última análise do site
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  searches SearchLead[]

  @@unique([source, externalId])
  @@index([dedupeKey])
  @@index([city, state])
  @@index([category])
  @@index([stars, score])
  @@index([siteStatus])
}

model Search {
  id        String  @id @default(cuid())
  category  String
  keywords  String?
  city      String
  state     String?
  radiusKm  Float   @default(10)
  provider  String  @default("auto") // "auto" | "google" | "osm"
  maxLeads  Int     @default(500)

  status   String  @default("queued") // SearchStatus em contract.ts
  error    String?
  // JSON com a fila de células da grade ainda não processadas; permite continuar de onde parou
  cursor   String?

  foundCount    Int @default(0)
  newCount      Int @default(0)
  updatedCount  Int @default(0)
  requestCount  Int @default(0)
  enrichedCount Int @default(0)

  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  leads SearchLead[]

  @@index([status])
  @@index([createdAt])
}

model SearchLead {
  searchId String
  leadId   String
  isNew    Boolean @default(false)
  search   Search  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  lead     Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([searchId, leadId])
  @@index([leadId])
}

model Schedule {
  id        String  @id @default(cuid())
  category  String
  keywords  String?
  city      String
  state     String?
  radiusKm  Float   @default(10)
  provider  String  @default("auto")
  maxLeads  Int     @default(500)

  frequency String // "daily" | "weekly" | "monthly"
  hour      Int     @default(3) // hora local de execução (0-23)
  active    Boolean @default(true)

  lastRunAt DateTime?
  nextRunAt DateTime
  createdAt DateTime  @default(now())

  searches Search[]

  @@index([active, nextRunAt])
}

// Leads excluídos a pedido (LGPD): nunca são reimportados.
model Blocked {
  source     String
  externalId String
  createdAt  DateTime @default(now())

  @@id([source, externalId])
}

// Configurações do app em pares chave/valor (JSON serializado). Hoje: "outreach".
model Setting {
  key   String @id
  value String
}

// ---------- Dados Abertos de CNPJ da Receita Federal (Story 1.6) ----------

/**
 * Estabelecimentos dos municípios importados. Só os campos usados no casamento e no
 * enriquecimento; o resto do dump é descartado durante a leitura em fluxo.
 */
model Cnpj {
  cnpj String @id // 14 dígitos: básico + ordem + dígito verificador

  razaoSocial  String? // vem do arquivo Empresas (pelo CNPJ básico)
  nomeFantasia String?
  // Nome comparável (normalizeName): fantasia e razão social, para o índice do casamento
  nomeNormalizado  String
  razaoNormalizada String

  municipio String // código de município da Receita (não é o do IBGE)
  uf        String

  bairro        String?
  logradouro    String?
  numero        String?
  cep           String?
  cnaePrincipal String?
  situacao      String? // 01 nula, 02 ativa, 03 suspensa, 04 inapta, 08 baixada

  phone  String? // "+55 DD NNNNNNNNN" montado a partir de DDD + telefone 1
  phone2 String?
  email  String?

  /** Mês do dump de onde a linha veio, no formato AAAA-MM. */
  dumpMonth  String
  importedAt DateTime @default(now())

  @@index([municipio, nomeNormalizado])
  @@index([municipio, razaoNormalizada])
}

/** Tabela de municípios da Receita (arquivo Municipios.zip): código → nome. */
model CnpjMunicipio {
  codigo          String @id
  nome            String
  nomeNormalizado String

  @@index([nomeNormalizado])
}

/**
 * Importação do dump + enriquecimento. Mesmo desenho da `Search`: o estado vive no banco,
 * então pausa, erro ou queda do servidor retomam do `cursor` salvo.
 */
model CnpjImport {
  id String @id @default(cuid())

  /** Mês do dump (AAAA-MM). */
  dumpMonth String
  /** JSON com o pedido da importação: municípios e partes do dump (`CnpjImportInput` em contract.ts). */
  cities    String

  status String  @default("queued") // CnpjImportStatus em contract.ts
  error  String?
  /** JSON com a etapa atual e a fila de arquivos pendentes; permite continuar de onde parou. */
  cursor String?

  /** Linhas de estabelecimento gravadas (dos municípios pedidos). */
  savedCount    Int @default(0)
  /** Linhas lidas do dump (todos os municípios). */
  scannedCount  Int @default(0)
  /** Leads examinados no enriquecimento. */
  examinedCount Int @default(0)
  /** Leads que casaram com um estabelecimento. */
  matchedCount  Int @default(0)
  /** Leads que ganharam telefone. */
  phoneCount    Int @default(0)
  /** Leads que ganharam e-mail. */
  emailCount    Int @default(0)
  /** Leads com mais de um candidato e sem desempate (não recebem contato). */
  ambiguousCount Int @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status])
  @@index([createdAt])
}
