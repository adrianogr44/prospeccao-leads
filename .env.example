# Copie para .env e preencha. Nunca versione o .env.

# Banco SQLite local (caminho relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"

# Google Places API (New). Sem a chave, o sistema usa só o OpenStreetMap.
# Crie em https://console.cloud.google.com > APIs e serviços > Credenciais
# e ative "Places API (New)". Restrinja a chave a essa API.
GOOGLE_PLACES_API_KEY=""

# Exportação para Google Sheets (opcional).
# JSON da conta de serviço em uma linha. Compartilhe a planilha com o e-mail dela (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Identificação enviada ao OpenStreetMap e aos sites analisados (exigência de uso do Nominatim).
CONTACT_EMAIL="seu-email@exemplo.com"
